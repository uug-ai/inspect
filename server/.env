# Local development defaults for the inspect server. Committed: NO SECRETS HERE.
# Put your token and personal overrides in .env.local (gitignored), which wins
# over this file. Real environment variables win over both.

PORT=8080

# Real GitHub mode: media is committed to an orphan branch, issues are created.
# For a no-GitHub run, set INSPECT_DRY_RUN=true and INSPECT_STORE=local in .env.local.
INSPECT_STORE=github
INSPECT_DRY_RUN=false

# Where test issues go. Change this in .env.local to a private sandbox repo if you
# don't want test issues and screenshots in a public repository.
INSPECT_DEFAULT_REPO=uug-ai/inspect
INSPECT_ALLOWED_REPOS=uug-ai/inspect
INSPECT_ASSETS_BRANCH=inspect-assets

# The demo app (client: npm run dev).
INSPECT_ALLOWED_ORIGINS=http://localhost:5180

INSPECT_LABELS=inspect
INSPECT_RATE_LIMIT=60

# Used only by INSPECT_STORE=local.
INSPECT_LOCAL_DIR=./data
